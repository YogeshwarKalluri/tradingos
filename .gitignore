# Virtual environment
.venv/
venv/
env/

# Environment variables (contains secrets)
.env
.env.local
.env.*.local

# Python cache
__pycache__/
*.py[cod]
*$py.class

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
logs/
*.log

# Data files
# Ignore the contents rather than the directory: git does not descend into an
# excluded directory, so a negation inside `data/` would never take effect.
# The directory itself must exist -- the duckdb/sqlite pools open databases in
# it and do not create it.
data/*
!data/.gitkeep
*.duckdb
*.db
*.sqlite

# Model files (large)
models/**/*.gguf
models/**/*.bin
models/**/*.safetensors
models/**/*.engine
models/**/*.onnx

# Cache
cache/
.pytest_cache/
.coverage
htmlcov/

# Build
dist/
build/
*.egg-info/

# Temporary files
*.tmp
*.temp